# Postgres connection string (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL=

IMAP_HOST=imap.titan.email
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_PROCESSED_FOLDER=Imported
# Where unparseable emails go after MAX_ERROR_ATTEMPTS (3) failed retries, so they stop being retried forever
IMAP_FAILED_FOLDER=Failed

# Substring match against the email subject; leave empty to match every unread email
EMAIL_FILTER_SUBJECT=

# Shared secret the external cron service must send as "Authorization: Bearer <value>"
CRON_SECRET=

ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5 if unset
ANTHROPIC_MODEL=claude-sonnet-5

# Meta (Facebook) Lead Ads direct API polling — leave both empty to disable this source entirely
# System User Access Token from Business Manager, with leads_retrieval/pages_read_engagement/pages_show_list
META_PAGE_ID=
META_ACCESS_TOKEN=
